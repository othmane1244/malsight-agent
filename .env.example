# Variables lues par src/malsight/agent/pipeline.py (valeurs par défaut indiquées).
# Le projet ne charge pas ce fichier automatiquement : définir les variables dans le shell,
# par exemple en PowerShell : $env:LLM_MODEL = "gemma4:e4b"
# Ne jamais committer de vraie clé : .env est ignoré par git.

# Fournisseur LLM : "ollama" (local, recommandé) ou "anthropic"
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:e4b

# Ollama uniquement
OLLAMA_HOST=http://localhost:11434
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=2048
LLM_TIMEOUT_S=600

# Anthropic uniquement (nécessite aussi : pip install langchain-anthropic) ; valeur factice
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
